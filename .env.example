# Ampe-DB V1 website — environment variables (README → Environment variables).
# Copy to .env.local for local work; set the same names in Vercel →
# Settings → Environment Variables. Never commit real values.

# Public address of the site, no trailing slash. Used in the emailed link.
SITE_URL=http://localhost:3000

# Signs the download tokens. Generate with: openssl rand -base64 32
DOWNLOAD_TOKEN_SECRET=

# How long a personal download link works, in whole days. The site copy reads it too.
DOWNLOAD_LINK_TTL_DAYS=7

# Google service account with Editor access to the sheet. Paste the private
# key on one line with literal \n between lines, in double quotes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# From the sheet's URL: docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=

# Project Gmail address and its app password (needs 2-Step Verification).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Cloudflare Turnstile. The site key is the only public value on the site.
# Locally, Cloudflare's always-pass test keys work:
#   site key 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Drive file IDs of the six release archives, each shared as
# "Anyone with the link · Viewer". Server-only.
DRIVE_FILE_VIDEOS=
DRIVE_FILE_POSE=
DRIVE_FILE_SKELETON_VIDEOS=
DRIVE_FILE_SKELETON_COORDINATES=
DRIVE_FILE_ANNOTATIONS_METADATA=
DRIVE_FILE_RESEARCH_DOCS=
